# 本番用環境変数のテンプレート。
# CT では ~/.401.env にコピーして実値を設定し、デプロイ時に .env.prod として展開される。
#   cp .env.prod.example ~/.401.env && vim ~/.401.env
# このファイル(.example)のみ git 管理し、実値の .env.prod は .gitignore 済み。

# --- PostgreSQL ---
POSTGRES_DB=app
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me-strong-password

# backend からの接続文字列 (ホストは compose のサービス名 db)
DATABASE_URL=postgres://user:change-me-strong-password@db:5432/app?sslmode=disable&TimeZone=Asia%2FTokyo

# --- セッション署名鍵 (必ず十分に長いランダム値に) ---
# 生成例: openssl rand -hex 32
SECRET_KEY=change-me-random-32bytes-hex

# --- Google OAuth ---
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx
# 公開ドメインに合わせる (Google コンソールの承認済みリダイレクト URI と一致必須)
OAUTH_REDIRECT_URL=https://yoyaku.example.com/callback

# --- フロント連携 ---
# ログイン後のリダイレクト先。公開オリジン。
FRONTEND_URL=https://yoyaku.example.com
# 同一オリジン配信なので CORS は基本不要。別オリジンから叩く場合のみカンマ区切りで指定。
CORS_ORIGINS=
# HTTPS(Cloudflare) 配信なので Cookie は Secure=true
COOKIE_SECURE=true

# --- 通知など ---
GOOGLE_CALENDAR_SYNC_ENABLED=false
SLACK_NOTIFY_ENABLED=false
SLACK_WEBHOOK_URL=

# --- フロントのビルド引数 (通常は空=相対パス。CI 側で渡す想定なので任意) ---
NEXT_PUBLIC_API_URL=
