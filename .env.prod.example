# ===== 401予約アプリ 本番環境変数 =====
# VM 上で /etc/401-yoyaku/.env にコピーし、値を実際のものに置き換える。
# (scripts/setup-container.sh が自動で配置する)
# (deploy.yml がこのファイルを .env として復元して docker-compose.prod.yml に渡す)

# --- PostgreSQL (compose の db サービス) ---
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-strong-password

# --- backend ---
# DATABASE_URL は上の POSTGRES_* と一致させる。ホストは compose のサービス名 "db"。
DATABASE_URL=postgres://app:change-me-strong-password@db:5432/app?sslmode=disable&TimeZone=Asia%2FTokyo
# セッション署名キー (十分に長いランダム文字列)
SECRET_KEY=change-me-session-signing-key

# --- Google OAuth (Cloud Console のクライアント) ---
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxx
# 本番ドメイン配下。Cloud Console の「承認済みリダイレクト URI」にも同じ値を登録する。
GOOGLE_REDIRECT_URL=https://yoyaku.ayuayuyu.dev/callback
# ログイン後の戻り先。CORS 許可オリジンにもなる。
FRONTEND_URL=https://yoyaku.ayuayuyu.dev
# HTTPS 配信なので Secure Cookie を有効化する。
COOKIE_SECURE=true

# --- 管理者 ---
# 初期管理者のメール (カンマ区切り)。ログイン時に該当ユーザを admin へ自動昇格する。
# ログインは @pluslab.org ドメインに限定されるため、ここも同ドメインのアドレスを指定する。
# 以降の権限付与は管理ページから行える。
ADMIN_EMAILS=admin@pluslab.org

# --- Slack 通知 (任意) ---
SLACK_NOTIFY_ENABLED=true
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# --- 共有 Google カレンダー同期 (任意) ---
# 予約者本人のカレンダーへの追加は OAuth 側で行うため、ここは「401号室の共有
# カレンダー」にサービスアカウントで書き込む場合だけ true にする。
# true にしたら下 2 つは必須 (未設定だと同期がエラーになる)。
GOOGLE_CALENDAR_SYNC_ENABLED=false
# GOOGLE_CALENDAR_ID=xxxxxxxx@group.calendar.google.com
# サービスアカウントの鍵 JSON。docker compose の .env は複数行を扱えないので
# 1 行に潰してシングルクォートで囲む: GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Cloudflare Tunnel ---
# Zero Trust → Networks → Tunnels で発行したトークン。
TUNNEL_TOKEN=eyJhIjoi...
