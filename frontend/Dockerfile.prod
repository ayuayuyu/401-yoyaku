# 本番用 frontend イメージ: Next static export(out/) を nginx で配信し、
# /api・/login・/callback を backend へリバースプロキシする (same-origin)。
# 開発用は Dockerfile (next dev) を使う。
FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# same-origin 配信のため API ベースURLは空 (相対パス /api, /login になる)。
ARG NEXT_PUBLIC_API_URL=""
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}

RUN npm run build

# ---- runtime (nginx) ----
FROM nginx:alpine

COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/out /usr/share/nginx/html

EXPOSE 80
