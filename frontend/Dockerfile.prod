# 本番用: next build (static export) の out/ を nginx で配信する。
# 開発用 (next dev ホットリロード) は同ディレクトリの Dockerfile を使う。

FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# 同一オリジン配信のため API URL は空 (=相対パス /api, /login) をデフォルトにする。
# ビルド時に固定される値なので build-arg で受け取る。
ARG NEXT_PUBLIC_API_URL=""
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/out /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
