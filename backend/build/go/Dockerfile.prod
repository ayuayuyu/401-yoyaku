# 本番用: マルチステージでスタティックバイナリを作り、最小イメージで実行する。
# 開発用 (air ホットリロード) は同ディレクトリの Dockerfile を使う。
# ビルドコンテキストは backend/src (go.mod のある場所)。

FROM golang:1.25-alpine AS build
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# CGO 無効・シンボル除去で小さなスタティックバイナリにする
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /server .

FROM alpine:3.20
# HTTPS(Google OAuth) 用の CA と JST タイムゾーン
RUN apk add --no-cache ca-certificates tzdata
ENV TZ=Asia/Tokyo
COPY --from=build /server /server
EXPOSE 8080
ENTRYPOINT ["/server"]
