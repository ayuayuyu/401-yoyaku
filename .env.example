# 401号室予約管理アプリ — 開発用の環境変数テンプレート。
#
#   cp .env.example .env
#
# このファイル1つを frontend / backend / db すべてが参照する。
# サービスごとの .env は置かない (backend/.env, frontend/.env は廃止)。
# 本番用のキーは .env.prod.example を参照。

# --- PostgreSQL (compose の db サービス) ---
POSTGRES_DB=app
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# --- backend ---
# DATABASE_URL はここには書かない。compose が上の POSTGRES_* から組み立てる。
# セッション署名キー。開発用なので任意の文字列でよい。
SECRET_KEY=dev-secret-key
# ログイン後の戻り先。CORS 許可オリジンにもなる。
FRONTEND_URL=http://localhost:3000
# 開発は HTTP なので false。本番 (HTTPS) のみ true。
COOKIE_SECURE=false

# --- Google OAuth (Cloud Console のクライアント) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cloud Console の「承認済みリダイレクト URI」にも同じ値を登録する。
GOOGLE_REDIRECT_URL=http://localhost:8080/callback

# --- 管理者 ---
# 初期管理者のメール (カンマ区切り)。ログイン時に admin へ自動昇格する。
ADMIN_EMAILS=

# --- frontend ---
# Docker 開発時は compose がこの値を渡す。ホストで `pnpm dev` する場合は
# next.config.ts がこのファイルから直接読む。
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Slack 通知 (任意) ---
SLACK_NOTIFY_ENABLED=false
SLACK_WEBHOOK_URL=

# --- 共有 Google カレンダー同期 (任意) ---
# 予約者本人のカレンダーへの追加は OAuth 側で行うため、ここは「401号室の共有
# カレンダー」にサービスアカウントで書き込む場合だけ true にする。
GOOGLE_CALENDAR_SYNC_ENABLED=false
# GOOGLE_CALENDAR_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON=
